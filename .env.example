# URL base del backend (AuthAndProfiles), SIN /api/v1 al final.
VITE_API_URL=http://localhost:8080

# Client ID de Google OAuth (Google Cloud Console > Credentials)
VITE_GOOGLE_CLIENT_ID=

# Client ID de la OAuth App de GitHub.
# OJO: se llama VIT_ (sin la E) porque en Vercel no se pudo registrar como VITE_.
# vite.config.ts lo expone gracias a envPrefix: ['VITE_', 'VIT_'].
VIT_GITHUB_CLIENT_ID=

# Opcional: por defecto es <origin>/auth/github/callback
# VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback
